# ─────────────────────────────────────────────
# Aetheris Health AI — Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env and fill in values.
#   cp .env.example .env
# NEVER commit the filled .env file.

# ── App ──────────────────────────────────────
APP_NAME="Aetheris Health AI"
APP_ENV="development"
APP_DEBUG=true
APP_BASE_URL="http://localhost:8000"
# Signs every access token and MFA ticket. There is no default and none is
# shipped here: a key that appears in a repository is a key everyone has.
# Generate a private one per environment and keep it in your secrets manager:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Outside development the application refuses to start while this is blank,
# shorter than 32 characters, or a value that was ever published. In
# development a blank value means a random key per process (sessions do not
# survive a restart).
APP_SECRET_KEY=

# ── Database ─────────────────────────────────
DATABASE_URL="postgresql+asyncpg://aetheris:aetheris@localhost:5432/aetheris"
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# ── Redis ────────────────────────────────────
REDIS_URL="redis://localhost:6379/0"

# ── Logging ──────────────────────────────────
LOG_LEVEL="INFO"
LOG_FORMAT="json"

# ── CORS ─────────────────────────────────────
CORS_ORIGINS='["http://localhost:5173","http://localhost:3000"]'

# ── JWT (Sprint 2) ──────────────────────────
# JWT_PRIVATE_KEY="..."
# JWT_PUBLIC_KEY="..."
# JWT_ISSUER="aetheris"
# JWT_ACCESS_TTL_SECONDS=900
# JWT_REFRESH_TTL_SECONDS=604800

# ── AI (optional) ───────────────────────────
# One AI feature exists: slot suggestions when booking an appointment
# (docs/08-AI_ARCHITECTURE.md). It is OFF unless GROQ_API_KEY is set. With no
# key the application starts normally and every other module works.
#
# Required to turn AI on. Never commit a real key.
# GROQ_API_KEY="gsk_your-key-here"
#
# Everything below is optional; the value shown is the default.
# Kill switch. Unset = on when a key is present; false = off even with a key.
# AI_ENABLED=true
# Model for the "fast" hint. Unset = the repository default in
# backend/app/ai/constants.py (openai/gpt-oss-20b). Must be a model Groq serves.
# AI_FAST_MODEL="openai/gpt-oss-20b"
# Groq's OpenAI-compatible API. Must be https (http only to localhost), with
# no credentials, query or fragment.
# GROQ_BASE_URL="https://api.groq.com/openai/v1"
# Total deadline for one model call, in seconds (max 30). No retry follows.
# AI_REQUEST_TIMEOUT_SECONDS=8
# Send a strict JSON Schema so the model can only answer with an offered slot.
# Set false only for a model that rejects it; the server validates either way.
# GROQ_STRICT_JSON_SCHEMA=true
# Model calls this process may have in flight at once (1-64).
# AI_MAX_CONCURRENT_CALLS=4
#
# Not read by any code yet: the Anthropic and OpenAI adapters are unregistered
# stubs, and there is no Gemini adapter.
# ANTHROPIC_API_KEY="sk-..."
# OPENAI_API_KEY="sk-..."
# GOOGLE_API_KEY="..."

# ── MFA secret encryption at rest ───────────
# Fernet key that encrypts MFA (TOTP) secrets in the database. No default.
# Generate one:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Unset in development: MFA enrol/verify answer 503, everything else works.
# Required in staging and production — the app refuses to start without it.
# Never commit a real key. Losing it means every enrolled user must redo MFA.
MFA_ENCRYPTION_KEY=
# Comma-separated retired keys, still accepted for decryption during rotation
# (then run `make rotate-mfa-keys`). Leave empty unless rotating.
MFA_ENCRYPTION_PREVIOUS_KEYS=

# ── Object Storage (Sprint 3) ───────────────
# S3_ENDPOINT="http://localhost:9000"
# S3_ACCESS_KEY="minioadmin"
# S3_SECRET_KEY="minioadmin"
# S3_BUCKET="aetheris"

# ── Email / SMS (Sprint 3) ──────────────────
# SMTP_HOST="smtp.sendgrid.net"
# SMTP_PORT=587
# SMTP_USER="apikey"
# SMTP_PASSWORD="..."
# EMAIL_FROM="noreply@aetheris.health"

# ── SMS (Patient App sign-in codes) ─────────
# SMS is OFF unless SMS_PROVIDER is set. With no provider the Patient App
# cannot send a sign-in code and answers 503; it never pretends one was sent.
# No vendor adapter exists yet. The only value is "dev", which prints the code
# to this process's standard output: it works only when APP_ENV=development,
# and the application refuses to start with it anywhere else. An unknown name
# is refused too.
# SMS_PROVIDER=
# Credential and sender identity for a real provider, when one is added.
# Never commit a real credential.
# SMS_API_KEY=
# SMS_SENDER_ID=
# Deadline for sending one SMS, in seconds (max 30).
# SMS_TIMEOUT_SECONDS=

# ── Patient App ─────────────────────────────
# Key of the keyed hash a sign-in code is stored under. No default and none is
# shipped here. At least 32 characters; generate one per environment and keep
# it in your secrets manager:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Required in staging and production — the app refuses to start without it.
# In development a blank value means a random key per process (codes already
# sent do not survive a restart).
# PATIENT_OTP_SECRET=
# Country calling codes a sign-in code may be sent to (JSON array). Anything
# else is refused: every code costs money.
# PATIENT_OTP_ALLOWED_COUNTRY_CODES=
# Send the patient cookies as Secure with their __Secure-/__Host- name
# prefixes. May be false only when APP_ENV=development (plain-HTTP localhost).
# PATIENT_COOKIE_SECURE=
# Origins the Patient App is served from (JSON array). The cookie endpoints
# (refresh, logout) refuse a request whose Origin is not listed. If the app is
# served from another origin than this API, that origin must also be in
# CORS_ORIGINS.
# PATIENT_APP_ORIGINS=

# ── Rate Limiting ───────────────────────────
RATE_LIMIT_ANON_PER_MIN=60
RATE_LIMIT_USER_PER_MIN=300
RATE_LIMIT_AI_PER_MIN=30
# Is there a reverse proxy in front of this application? There is no default
# answer. Outside development the application refuses to start until you
# choose one, and a blank value is refused too.
#   false — clients connect directly. X-Forwarded-For is ignored.
#   true  — ONLY behind a reverse proxy you operate that appends
#           X-Forwarded-For. The client address is then read
#           RATE_LIMIT_TRUSTED_PROXY_HOPS entries from the right of that
#           header, and only on connections arriving from
#           RATE_LIMIT_TRUSTED_PROXY_CIDRS (JSON array; default: private and
#           loopback ranges). A caller connecting from anywhere else is never
#           believed about its own address.
# Choosing wrongly is not harmless: "false" behind a proxy makes every user
# look like one caller; "true" without one lets callers on a trusted network
# name their own address.
# RATE_LIMIT_TRUST_PROXY_HEADER=
# RATE_LIMIT_TRUSTED_PROXY_HOPS=1
# RATE_LIMIT_TRUSTED_PROXY_CIDRS='["10.0.0.0/8"]'
